{
	// One long-lived Codespace that runs LearnHarness in the browser.
	// Setup, secrets and the data backup are described in .devcontainer/README.md.
	"name": "LearnHarness",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
	"features": {
		// CI and release builds use Node 26 (.github/workflows/ci.yml).
		"ghcr.io/devcontainers/features/node:1": { "version": "26" },
		// Lets `gh codespace ssh` and `gh codespace logs` reach the container.
		"ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
	},
	"hostRequirements": { "cpus": 4, "memory": "8gb" },
	"containerEnv": {
		// Learning data and keys live outside the git working tree, under
		// /workspaces so they survive stopping and restarting the codespace.
		"LH_DATA_DIR": "/workspaces/.lh-data",
		"LH_AUTH_FILE": "/workspaces/.lh-auth/auth.json",
		"LH_PORT": "3100",
		"NEXT_TELEMETRY_DISABLED": "1",
		// The browser app does not need the Electron desktop runtime.
		"ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"postStartCommand": "bash .devcontainer/post-start.sh",
	"forwardPorts": [3100],
	"portsAttributes": {
		"3100": {
			"label": "LearnHarness",
			// Forwarded ports are private (your GitHub sign-in only) by default.
			// Never make this one public: the app has no login of its own.
			"onAutoForward": "openBrowser"
		}
	},
	"customizations": {
		"codespaces": {
			"openFiles": [".devcontainer/README.md"]
		}
	}
}
